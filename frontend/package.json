{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc && vite build --minify false --mode development",
    "build": "vue-tsc && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write src e2e public/style.css public/themes *.ts *.json index.html README.md"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "@wailsio/runtime": "3.0.0-beta.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "element-plus": "^2.14.6",
    "gsap": "^3.15.0",
    "pinia": "3.0.4",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unplugin-element-plus": "^0.11.2",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "20.14.5",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vite": "^8.0.5",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
